<%#
  下層ページ末尾の締め：横長の写真＋見出し＋リード＋ボタン群（スタイル：scss/layout/_page.scss .l-page-closing）
    include('partials/_page-closing', { img: 'common/closing.webp', ttl: '...', txt: '...', btns: [{ label, href, variant }] })
  引数
    img  … 写真（1536×428）。assets/img/ からのパス
    ttl  … 見出し（HTML 可）
    txt  … リード文（HTML 可）。省略可（省略時はボタンを見出しに寄せる）
    btns … _link-btn.ejs の引数の配列（size は 'lg' 固定）
%>
<section class="l-page-closing">
  <div class="l-page-closing__img">
    <img src="<%= assets %>img/<%= img %>" alt="" width="1536" height="428" loading="lazy">
  </div>
  <div class="l-page-closing__inner">
    <h2 class="l-page-closing__ttl"><%- ttl %></h2>
    <% if (typeof txt !== 'undefined' && txt) { %>
      <p class="l-page-closing__txt"><%- txt %></p>
    <% } %>
    <ul class="l-page-closing__btns">
      <% btns.forEach((btn) => { %>
        <li><%- include('partials/_link-btn', { ...btn, size: 'lg' }) %></li>
      <% }) %>
    </ul>
  </div>
</section>
