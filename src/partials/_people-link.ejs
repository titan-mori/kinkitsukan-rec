<%#
  社員インタビューへの導線（スタイル：scss/component/_people-link.scss、SP スライダー：main.js initPeopleLinkSwiper）
  PC：左に見出し・リード・ボタン、右に写真（斜めに並べた写真を1枚に書き出したもの）
  SP：見出し・リード・ボタンの下に、縦長の写真を横に並べたスライダー（スワイプのみ・ループなし）
    include('partials/_people-link', { img: 'special/interviewbtn.webp', imgsSp: ['top/people_01.webp', …], lead: '…' })
  引数
    img    … PC の写真（650×393。書き出しは 2 倍の 1300×786）。assets/img/ からのパス
    imgsSp … SP スライダーの写真の配列（146×184 で切り抜き）。assets/img/ からのパス
    lead   … リード文。省略可
    href   … ボタンのリンク先。省略時は interview/
%>
<%
  const plLead = typeof lead !== 'undefined' ? lead : '働く人の、本当の声を聞いてみました。';
  const plHref = typeof href !== 'undefined' ? href : root + 'interview/';
%>
<section class="c-people-link">
  <div class="c-people-link__body">
    <div class="c-ttl">
      <p class="c-ttl__label"><span class="c-ttl__en">PEOPLE</span><span class="c-ttl__ja">/ 人を知る</span></p>
      <h2 class="c-ttl__main c-people-link__ttl">社員インタビュー</h2>
    </div>
    <p class="c-people-link__lead"><%- plLead %></p>
    <a class="c-btn c-btn--wide c-people-link__btn" href="<%= plHref %>"><span><span class="c-people-link__btn-sp">社員</span><span class="c-people-link__btn-pc">すべての</span>インタビューを見る</span><%- include('partials/_arrow') %></a>
  </div>
  <%# PC：1枚画像（SP では非表示。loading="lazy" なので SP では読み込まれない） %>
  <div class="c-people-link__photos">
    <img src="<%= assets %>img/<%= img %>" alt="画像" width="650" height="393" loading="lazy">
  </div>
  <%# SP：写真のスライダー（装飾なので読み上げ対象外） %>
  <div class="swiper c-people-link__slider" data-people-link-swiper aria-hidden="true">
    <ul class="swiper-wrapper">
      <% imgsSp.forEach((src) => { %>
        <li class="swiper-slide c-people-link__slide"><img src="<%= assets %>img/<%= src %>" alt="画像" width="146" height="184" loading="lazy"></li>
      <% }) %>
    </ul>
  </div>
</section>
